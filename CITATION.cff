cff-version: 1.2.0
title: "pangeo-keynote-figures: code and data behind the figures of the keynote 'Pangeo: Openness for Sovereignty, Innovation, and Sustainable Communities'"
message: "If you use this software, please cite it as below."
type: software
authors:
  - family-names: "Fouilloux"
    given-names: "Anne"
    orcid: "https://orcid.org/0000-0002-1784-2920"
    affiliation: "LifeWatch ERIC"
repository-code: "https://github.com/annefou/pangeo-keynote-figures"
license: MIT
version: "0.1.0"
date-released: "2026-10-06"
# Identifiers below are recorded AUTOMATICALLY on each release by
# .github/workflows/release-identifiers.yml — don't fill them in by hand.
#
# `doi:` is the CONCEPT DOI: it means "cite this project" and deliberately
# resolves to whatever version is latest. That floating behaviour is correct
# HERE and wrong in a nanopub — see scripts/set_release_identifiers.py.
#
# (This used to say "run /init-template again or edit by hand". /init-template
# deletes itself as its final step, so by the time a DOI existed the skill it
# named was gone and "edit by hand" was the only path left. Two repos built from
# this template then recorded the version DOI two different ways — one a
# structured identifier, one a prose comment. Hence the automation.)
doi: "{{ZENODO_DOI}}"
identifiers:
  - type: doi
    value: "{{ZENODO_DOI}}"
    description: "Concept DOI (resolves to the latest version) — cite the project"
  # On release, the workflow adds:
  #   - type: doi   value: <version DOI>  "Version DOI for vX.Y.Z — pins this exact release; cite this from nanopubs"
  #   - type: swh   value: swh:1:rev:<commit>;origin=<repo>  "Software Heritage ID of the vX.Y.Z source tree"
abstract: "Reproducible pipeline for the Earth-observation figures of the keynote given at the OpenEarthMonitor final event (CREAF, 7 October 2026): Copernicus Sentinel-2 and Sentinel-3 read from ESA's EOPF Zarr with Xarray, GBIF records read with healpix-connector, all placed on WGS84 NESTED HEALPix cells with healpix-geo and joined by cell ID."
keywords:
  - Pangeo
  - Copernicus
  - Sentinel-2
  - Sentinel-3
  - EOPF
  - Zarr
  - HEALPix
  - DGGS
  - GBIF
  - biodiversity
  - reproducibility
  - FORRT
references:
  - type: conference
    title: "Pangeo: Openness for Sovereignty, Innovation, and Sustainable Communities"
    conference:
      name: "OpenEarthMonitor final event"
      city: "Barcelona"
      date-start: "2026-10-07"
    authors:
      - family-names: "Fouilloux"
        given-names: "Anne"
    year: "2026"
    doi: "{{PAPER_DOI}}"
